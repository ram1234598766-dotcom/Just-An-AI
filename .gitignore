# --- Node ---
node_modules/
dist/
*.tsbuildinfo
coverage/

# --- Env & secrets (never commit keys) ---
.env
.env.*
!.env.example

# npm pack output - a tarball is a full copy of the shipped surface
*.tgz

# --- Logs & caches ---
*.log
logs/
.vitest-cache/

# --- JAA local state ---
.jaa/
*.db
*.sqlite

# --- pty harness artifacts ---
# The pty driver runs the real CLI against a throwaway JAA_HOME and a recording
# file. `tests/tui-pty.test.ts` cleans both up itself, but a manual run - or a
# run that was interrupted - leaves a `config.json` that looks exactly like a
# file someone meant to commit.
.pty-home/
.tmp-tui-pty*

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
